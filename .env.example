# Study Timer — Environment Variables
# Copy this file to .env and fill in your values
# .env is git-ignored — never commit actual secrets

# ── Frontend ────────────────────────────────────────────────────────────────
# PocketBase backend URL. Used by the frontend at build time (Vite injects it).
# For local dev: http://localhost:8090
# For production: https://your-domain.com (Caddy proxies /api/* to pocketbase:8090)
VITE_PB_URL=http://localhost:8090

# ── Production deployment ────────────────────────────────────────────────────
# Your server domain (used by Caddy for HTTPS via Let's Encrypt)
# Example: study.yourdomain.com
DOMAIN=your-domain-here.com

# ── Web Push (VAPID) — implemented in F6 ─────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY is also used by the frontend (not a secret)
# VAPID_PRIVATE_KEY is a server-side secret — never expose to frontend
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
# VAPID subject: mailto: or https: URL identifying your service
VAPID_SUBJECT=mailto:admin@your-domain-here.com
